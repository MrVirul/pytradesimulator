# Copy to .env and change values, then recreate the containers that read them.
# With no .env file, Compose uses the defaults shown here.

PUBLIC_API_URL=http://localhost:8080
PUBLIC_KEYCLOAK_URL=http://localhost:8081
API_PORT=8080
KEYCLOAK_PORT=8081

POSTGRES_USER=pytradesim
POSTGRES_PASSWORD=pytradesim
POSTGRES_DB=pytradesim
APP_DB_PASSWORD=pytradesim

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_SCENARIO_CLIENT_SECRET=pytradesim-scenario

DEMO_MARKET_PASSWORD=market
DEMO_ANALYST_PASSWORD=analyst
DEMO_ADMIN_PASSWORD=admin
SHOW_DEMO_CREDENTIALS=1

COOKIE_SECURE=1
SESSION_MINUTES=15
